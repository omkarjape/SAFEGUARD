# Application Environment Variables

# Backend Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worker_safety_db?schema=public"

# CORS Origin
CLIENT_URL="http://localhost:5173"

# JWT Secret (for supervisor / admin auth)
JWT_SECRET="super-secret-industrial-safety-key-replace-in-prod"

# IoT Simulator Configuration
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=3000

# Device Heartbeat Offline Threshold (in milliseconds)
DEVICE_OFFLINE_THRESHOLD_MS=60000
